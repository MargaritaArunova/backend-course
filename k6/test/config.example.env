# Пример конфигурационного файла для k6 тестирования
# Скопируйте этот файл в config.env и настройте под свои нужды
# Использование: source config.env && ./k6/run-tests.sh

# Базовый URL API
export BASE_URL="http://localhost:8080"

# Длительность каждого теста
export DURATION="30s"

# Пропорция запросов POST /users (0.0 - 1.0)
# 0.5 = 50% POST /users, 50% GET /statistics/self-likes
# 1.0 = 100% POST /users
# 0.0 = 100% GET /statistics/self-likes
export POST_USERS_RATIO="0.5"

# Количество пользователей для заполнения БД
export USER_COUNT="100"

# Примеры различных конфигураций:

# Тестирование только создания пользователей
# export POST_USERS_RATIO="1.0"

# Тестирование только получения статистики
# export POST_USERS_RATIO="0.0"

# Более длительные тесты
# export DURATION="60s"

# Тестирование с большим количеством данных
# export USER_COUNT="1000"

# Тестирование удаленного сервера
# export BASE_URL="http://production-server.com:8080"